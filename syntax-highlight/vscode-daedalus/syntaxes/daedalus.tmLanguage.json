{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Daedalus",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.daedalus",
					"match": "\\b(if|while|for|return)\\b"
				}
			]
		}
	},
	"scopeName": "source.daedalus"
}
