module T057
 
--- Imports:
 
--- Type defs:
 
--- Rules:
 
T057.I ?a0 (P : Grammar ?a0) : Grammar ?a0 =
  P
 
T057.F (x : [uint 8]) (y : [uint 8]) : Grammar {} =
  do T057.I [uint 8] (MatchBytes x)
     ($$ : {}) <- do T057.I [uint 8] (MatchBytes y)
                     pure {}
     pure $$
 
T057.Main : Grammar {} =
  T057.F "[" "]"
