module D002
 
--- Imports:
 
--- Type defs:
type D002.Main0 = Choose { a: uint 8
                         ; b: uint 8
                         }
 
--- Rules:
 
D002.Main : Grammar {} =
  do Choose biased
       { {- a -} do (_1 : uint 8) <- Match {'b'}
                    pure {a: _1}
       | {- b -} do (_2 : uint 8) <- Match {'b'}
                    pure {b: _2}
       }
     ($$ : {}) <- END
     pure $$
