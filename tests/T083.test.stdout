module DaedalusMain
 
--- Imports:
 
--- Type defs:
 
--- Rules:
 
rec value
  T083.RecursiveDispatch : Grammar {} =
    Choose biased
      { T083.RecursiveOperator_5
      | Choose biased
          { T083.RecursiveOperator_6
          | END
          }
      }
   
  T083.RecursiveOperator_6 : Grammar {} =
    do Match {'b'}
       ($$ : {}) <- T083.RecursiveDispatch
       pure $$
   
  T083.RecursiveOperator_5 : Grammar {} =
    do Match {'a'}
       ($$ : {}) <- T083.RecursiveDispatch
       pure $$
 
T083.Main : Grammar {} =
  T083.RecursiveDispatch
