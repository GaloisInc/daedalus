--- Type defs:
 
--- Rules:
 
Det007.A : Grammar (uint 8) =
  Match {'a'}
 
Det007.B : Grammar (uint 8) =
  Match {'b'}
 
Det007.Test1 : Grammar (uint 8) =
  Choose biased
    { Choose fair
        { do Det007.A
             ($$ : uint 8) <- Det007.B
             pure $$
        | Det007.B
        }
    | Det007.A
    }
 
Det007.Test2 : Grammar (uint 8) =
  Choose fair
    { Choose biased
        { do Det007.A
             ($$ : uint 8) <- Det007.B
             pure $$
        | Det007.B
        }
    | Det007.A
    }
 
Det007.C : Grammar (uint 8) =
  Match {'c'}
 
Det007.D : Grammar (uint 8) =
  Match {'d'}
 
Det007.Test3 : Grammar (uint 8) =
  Choose fair
    { Choose biased
        { do Det007.A
             ($$ : uint 8) <- Det007.B
             pure $$
        | do Det007.A
             Det007.B
             ($$ : uint 8) <- Det007.C
             pure $$
        }
    | do Det007.A
         ($$ : uint 8) <- Det007.D
         pure $$
    }
 
Det007.Test4 : Grammar {} =
  Choose biased
    { do Det007.A
         pure {}
    | pure {}
    }
 
Det007.Main : Grammar {} =
  do Det007.Test1
     Det007.Test2
     Det007.Test3
     Det007.Test4
     ($$ : {}) <- END
     pure $$
