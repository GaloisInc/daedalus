--- Rules:
 
T057.I_7 (x : [uint 8]) : Grammar [uint 8] =
  MatchBytes x
 
T057.F (x : [uint 8]) (y : [uint 8]) : Grammar {} =
  do T057.I_7 x
     ($$ : {}) <- do T057.I_7 y
                     pure {}
     pure $$
 
T057.Main : Grammar {} =
  T057.F "[" "]"
